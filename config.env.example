# SHADOW private runtime configuration
# Copy to config.env locally or set values in your host's secret manager.
# Never commit config.env or share its values.

BOT_NAME=SHADOW
STICKER_NAME=SHADOW
OWNER_NAME=CASTRO
OWNER_NUMBER=
PREFIX=.
MODE=private

# Atlas project: Project 0 / Cluster0
# Dedicated SHADOW database and encrypted auth-state collection.
MONGODB_URI=
MONGODB_DATABASE=shadow
MONGODB_COLLECTION=shadow_auth_state
SHADOW_SESSION_ID=primary
SHADOW_SESSION_ENCRYPTION_KEY=

# Local pairing CLI only. Generate independent random 32-byte tokens.
SHADOW_PAIRING_TOKEN=
SHADOW_PAIRING_REQUEST_TOKEN=

# Optional features remain disabled until their handlers are reviewed.
AUTO_STATUS_SEEN=false
AUTO_STATUS_REPLY=false
AUTO_STATUS_REACT=false
ANTI_DELETE=false
WELCOME=false
ADMIN_EVENTS=false
ANTI_LINK=false
DELETE_LINKS=false
AUTO_REPLY=false
AUTO_STICKER=false
AUTO_VOICE=false
AUTO_TYPING=false
ALWAYS_ONLINE=false
READ_MESSAGE=false
READ_CMD=false
ANTI_CALL=false
