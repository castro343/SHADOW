# SHADOW safe configuration template
# Copy to config.env on the host. Never commit config.env.

BOT_NAME=SHADOW
STICKER_NAME=SHADOW
OWNER_NAME=CASTRO
OWNER_NUMBER=
PREFIX=.
MODE=private

# Keep WhatsApp credentials/session material out of Git.
SESSION_ID=

# Optional feature flags (disabled by default)
AUTO_STATUS_SEEN=false
AUTO_STATUS_REPLY=false
AUTO_STATUS_REACT=false
ANTI_DELETE=false
WELCOME=false
ADMIN_EVENTS=false
ANTI_LINK=false
DELETE_LINKS=false
AUTO_REPLY=false
AUTO_STICKER=false
AUTO_VOICE=false
AUTO_TYPING=false
ALWAYS_ONLINE=false
READ_MESSAGE=false
READ_CMD=false
ANTI_CALL=false
